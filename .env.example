# Copy to .env (or set these in your host's dashboard) and restart the server.
# Nothing here is needed for a local try-out; defaults are used in development.

NODE_ENV=production
PORT=3000

# Public address of the deployment, used inside QR codes and notifications.
BASE_URL=https://crowdfeed.example.org

# Secrets (generate long random strings, e.g. openssl rand -hex 32)
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-too
COUPON_SECRET=change-me-three

# Database. Default is a local SQLite file. For hosts without a persistent disk
# (Render free tier) point this at a hosted Turso database instead.
DATABASE_URL=file:data/crowdfeed.db
# DATABASE_URL=libsql://your-db-your-org.turso.io
# DATABASE_AUTH_TOKEN=...

# Web Push keys, create them with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.org

# Survey behaviour
SURVEY_MIN_QUESTIONS=5
SURVEY_MAX_QUESTIONS=8
SESSION_TTL_HOURS=24
COUPON_VALID_DAYS=30
PRESENCE_RADIUS_M=75
